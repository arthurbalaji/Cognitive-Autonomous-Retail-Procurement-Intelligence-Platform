# CARPIP monorepo ignore rules

# Operating-system metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors and IDEs
.idea/
.vscode/*
