!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Local environment, credentials, and certificates
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.key
*.pem
*.crt
