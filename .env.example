# =================================================================
# CARPIP Environment Configuration
# Copy this file to .env and fill in your values
# =================================================================

# ──── PostgreSQL ────
POSTGRES_PASSWORD=carpip_secure_password

# ──── JWT ────
JWT_SECRET=your-production-secret-key-must-be-at-least-256-bits-long-change-this
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ──── Flask ────
FLASK_SECRET_KEY=your-flask-secret-key-change-this

# ──── Google Cloud / Vertex AI (Gemini) ────
# Path to GCP service account JSON for Gemini-powered negotiations.
# Leave empty to use rule-based fallback agents.
GOOGLE_APPLICATION_CREDENTIALS=./ai-service/credentials/service-account.json
GCP_PROJECT_ID=gen-lang-client-0550374026
GCP_LOCATION=us-central1

# ──── Kafka ────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ──── Redis ────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ──── CORS ────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ──── ERP Sync ────
ERP_SYNC_CRON=0 */5 * * * *
